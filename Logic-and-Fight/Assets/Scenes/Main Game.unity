--- !u!114 &1679507802
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679507800}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.83, g: 0.83, b: 0.83, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<color=#9CDCFE>ore_count</color> = <color=#B5CEA8>0</color>\n<color=#569CD6>while</color>
    <color=#569CD6>True</color>:\n    <color=#569CD6>if</color> <color=#DCDCAA>get_tile_type</color>()
    == <color=#4EC9B0>Tiles</color>.<color=#9CDCFE>Stone</color>:\n        <color=#DCDCAA>mine</color>()\n       
    <color=#9CDCFE>ore_count</color> = <color=#9CDCFE>ore_count</color> + <color=#B5CEA8>1</color>\n   
    <color=#9CDCFE>x</color>, <color=#9CDCFE>y</color> = <color=#DCDCAA>get_pos_x</color>(),
    <color=#DCDCAA>get_pos_y</color>()\n    <color=#9CDCFE>world_size</color> = <color=#DCDCAA>get_world_size</color>()
    / <color=#B5CEA8>2</color>\n    <color=#569CD6>if</color> <color=#9CDCFE>x</color>
    < <color=#9CDCFE>world_size</color> <color=#569CD6>and</color> <color=#9CDCFE>y</color>
    < <color=#9CDCFE>world_size</color>:\n        <color=#569CD6>if</color> <color=#9CDCFE>ore_count</color>
    == <color=#9CDCFE>world_size</color>**<color=#B5CEA8>2</color>:\n           
    <color=#DCDCAA>return_home</color>()\n            <color=#9CDCFE>ore_count</color>
    = <color=#B5CEA8>0</color>\n        <color=#569CD6>if</color> <color=#DCDCAA>can_scan</color>()
    <color=#569CD6>and</color> <color=#DCDCAA>get_entity</color>() == <color=#4EC9B0>Entities</color>.<color=#9CDCFE>Ore</color>:\n           
    <color=#9CDCFE>ore_count</color> += <color=#B5CEA8>1</color>\n        <color=#569CD6>elif</color>
    <color=#DCDCAA>get_entity</color>() != <color=#4EC9B0>Entities</color>.<color=#9CDCFE>Ore</color>:\n           
    <color=#DCDCAA>mine</color>()\n            <color=#DCDCAA>place</color>(<color=#4EC9B0>Entities</color>.<color=#9CDCFE>Ore</color>)\n   
    <color=#569CD6>else</color>:\n        <color=#569CD6>if</color> <color=#DCDCAA>can_mine</color>():\n           
    <color=#DCDCAA>mine</color>()\n        <color=#9CDCFE>tile_type</color> = (<color=#9CDCFE>x</color>
    + <color=#9CDCFE>y</color>) % <color=#B5CEA8>4</color>\n        <color=#9CDCFE>tiles</color>
    = [<color=#4EC9B0>Tiles</color>.<color=#9CDCFE>Stone</color>, <color=#4EC9B0>Tiles</color>.<color=#9CDCFE>Iron</color>,
    <color=#4EC9B0>Tiles</color>.<color=#9CDCFE>Gold</color>, <color=#4EC9B0>Tiles</color>.<color=#9CDCFE>Stone</color>]\n       
    <color=#DCDCAA>place</color>(<color=#9CDCFE>tiles</color>[<color=#9CDCFE>tile_type</color>])\n   
    <color=#569CD6>if</color> <color=#9CDCFE>x</color> == <color=#9CDCFE>y</color>:\n       
    <color=#DCDCAA>move</color>(<color=#9CDCFE>North</color>)\n    <color=#569CD6>else</color>:\n       
    <color=#DCDCAA>move</color>(<color=#9CDCFE>West</color>)"
